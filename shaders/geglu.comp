#version 450
// gate = gelu(gate) * up (GeGLU activation for Gemma and modern architectures)
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer G { float gate[]; };
layout(std430, binding = 1) readonly buffer U { float up[]; };
layout(push_constant) uniform P { uint n; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    float g = gate[i];
    const float k = 0.7978845608028654; // sqrt(2.0 / 3.141592653589793)
    float g3 = g * g * g;
    float gelu_val = 0.5 * g * (1.0 + tanh(k * (g + 0.044715 * g3)));
    gate[i] = gelu_val * up[i];
}
