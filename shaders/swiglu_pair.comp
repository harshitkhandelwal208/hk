#version 450
// out[i] = silu(gu[2 i]) * gu[2 i + 1], for gate and up values stored interleaved.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer GU { float gu[]; };
layout(std430, binding = 1) writeonly buffer H { float h[]; };
layout(push_constant) uniform P { uint n; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    float g = gu[2u * i];
    h[i] = g / (1.0 + exp(-g)) * gu[2u * i + 1u];
}
